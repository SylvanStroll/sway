{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "source": "arch",
        "padding": {},
    "color": {
      "1": "#a6adc8",
      "2": "#bac2de"
    }
  },

  "display": {
    "separator": "   "
  },

"modules": [
  "break",
  {
    "type": "title",
    "color": {
      "user": "#cba6f7",
      "at":   "#cdd6f4",
      "host": "#cdd6f4"
    }
  },
  {
    "type": "separator",
    "string": "─",
    "color": {
      "separator": "38;2;88;91;112"
    }
  },

    "break",

    { "type": "os",       "key": "  OS        ", "keyColor": "#89dceb" },
    { "type": "kernel",   "key": "  KERNEL    ", "keyColor": "#89dceb" },
    { "type": "shell",    "key": "  SHELL     ", "keyColor": "#89dceb" },
    { "type": "wm",       "key": "  WM        ", "keyColor": "#74c7ec" },
    { "type": "terminal", "key": "  TERMINAL  ", "keyColor": "#74c7ec" },
    { "type": "cpu",      "key": "  CPU       ", "keyColor": "#74c7ec", "format": "{name}" },
    { "type": "gpu",      "key": "  GPU       ", "keyColor": "#89b4fa", "format": "{name}" },
    { "type": "uptime",   "key": "  UPTIME    ", "keyColor": "#89b4fa" },
    { "type": "packages", "key": "  PACKAGES  ", "keyColor": "#89b4fa" },
    { "type": "memory",   "key": "  MEMORY    ", "keyColor": "#b4befe" },
    { "type": "disk",     "key": "  DISK (/)  ", "keyColor": "#b4befe" },

    "break",
    {
      "type": "separator",
      "string": "─",
      "color": {
        "separator": "38;2;88;91;112"
      }
    }
  ]
}
